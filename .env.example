# Home Assistant websocket collector
# Required for LAN mode. In dev-ha mode, token can be auto-bootstrapped.
HA_TOKEN=replace-with-home-assistant-long-lived-token
HA_WS_URL=ws://homeassistant.local:8123/api/websocket
EVENT_TYPES=state_changed,call_service
DOMAIN_ALLOWLIST=
DOMAIN_EXCLUDELIST=automation,updater

# Local dev Home Assistant helpers.
DEV_HA_HTTP_URL=http://127.0.0.1:8123
DEV_HA_WS_URL=ws://127.0.0.1:8123/api/websocket
DEV_HA_DEMO_INTERVAL_SECONDS=10
DEV_HA_AUTO_BOOTSTRAP=true
DEV_HA_TOKEN_FILE=.dev-ha.token
DEV_HA_OWNER_NAME=HA AI Dev
DEV_HA_OWNER_USERNAME=ha_ai_dev
DEV_HA_OWNER_PASSWORD=ha_ai_dev_password
DEV_HA_OWNER_LANGUAGE=en
DEV_HA_CLIENT_ID=http://127.0.0.1:8123/
DEV_HA_REDIRECT_URI=http://127.0.0.1:8123/auth/external/callback
DEV_HA_TOKEN_CLIENT_NAME=ha-ai-collector-dev
DEV_HA_TOKEN_LIFESPAN_DAYS=3650
RETENTION_AUTOSTART=true

# Database
POSTGRES_DB=ha_ai
POSTGRES_USER=ha_ai
POSTGRES_PASSWORD=ha_ai_dev_password
DATABASE_URL=postgresql://ha_ai:ha_ai_dev_password@localhost:5432/ha_ai
TEST_DATABASE_URL=postgresql://ha_ai:ha_ai_dev_password@localhost:5432/ha_ai

# pgAdmin local debug defaults
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
# Set to "true" to require a pgAdmin master password prompt.
PGADMIN_MASTER_PASSWORD_REQUIRED=false
PGADMIN_DB_HOST=postgres
PGADMIN_DB_PORT=5432
PGADMIN_DB_NAME=ha_ai
PGADMIN_DB_USER=ha_ai
# Leave blank to reuse POSTGRES_PASSWORD automatically in local scripts.
PGADMIN_DB_PASSWORD=

# Collector tuning
BATCH_SIZE=250
FLUSH_INTERVAL_SECONDS=2
RECONNECT_INITIAL_SECONDS=1
RECONNECT_MAX_SECONDS=30
RECONNECT_JITTER_RATIO=0.2
MAX_BUFFERED_EVENTS=5000
OVERFLOW_POLICY=drop_newest
RETRY_BACKPRESSURE_DELAY_MS=250
COLLECTOR_INSTANCE_ID=collector-local

# Analytics
ANALYTICS_TIMEZONE=UTC
REPORT_OUTPUT_DIR=/tmp/ha-ai-reports
OPENAI_API_KEY=replace-with-openai-api-key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_ANALYSIS_MAX_INSIGHTS=5
LLM_ANALYSIS_WINDOW_HOURS=24
LLM_SCHEDULE_TIME=03:00
LLM_SCHEDULE_TIMEZONE=UTC
LLM_MAX_TOP_CHANGES=20
LLM_MAX_TRACE_CONTEXTS=10
LLM_MAX_EVENTS_PER_CONTEXT=60
LLM_TRACE_MAX_DEPTH=6
LLM_REQUEST_TIMEOUT_MS=30000
LLM_RETRY_MAX_ATTEMPTS=3

# Retention + partition management
RETENTION_SCHEDULE_TIME=03:30
RETENTION_SCHEDULE_TIMEZONE=UTC
EVENTS_RETENTION_DAYS=14
EVENTS_PARTITION_LOOKBACK_DAYS=2
EVENTS_PARTITION_PRECREATE_DAYS=14
TRACE_CONTEXTS_RETENTION_DAYS=30
ENTITY_SNAPSHOTS_RETENTION_DAYS=30
AUTOMATION_SNAPSHOTS_RETENTION_DAYS=60
AGENT_RUNS_RETENTION_DAYS=180
ORPHAN_ANALYSIS_RESULTS_RETENTION_DAYS=180
RETENTION_BATCH_SIZE=50000
