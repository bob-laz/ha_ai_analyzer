{
  "name": "ha-ai-analyzer",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "collector",
    "tools"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -t run build",
    "test": "yarn workspaces foreach -A run test",
    "test:integration": "bash scripts/run-integration-tests.sh",
    "test:integration:collector": "bash scripts/run-integration-tests.sh collector",
    "test:integration:tools": "bash scripts/run-integration-tests.sh tools",
    "dev:db:up": "bash scripts/run-db-dev.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "dev:collector": "bash scripts/run-collector-dev.sh",
    "dev:ha:up": "docker compose --profile dev-ha up -d homeassistant",
    "dev:ha:logs": "docker compose logs -f homeassistant",
    "dev:ha:emit-demo": "bash scripts/emit-ha-demo-events.sh",
    "verify": "yarn build && yarn lint && yarn test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:type": "yarn workspaces foreach -A run lint:type",
    "start:collector": "yarn workspace @ha-ai/collector start:collector",
    "start:analytics": "yarn workspace @ha-ai/tools start:analytics",
    "start:retention": "yarn workspace @ha-ai/tools start:retention",
    "start:analysis:once": "yarn workspace @ha-ai/tools start:analytics --once",
    "start:analysis:scheduler": "yarn workspace @ha-ai/tools start:analytics --schedule"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "typescript": "^5.9.3"
  }
}
