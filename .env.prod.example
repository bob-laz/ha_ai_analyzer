# Image release selected by deploy script
IMAGE_REPO=ghcr.io/bob-laz/ha_ai_analyzer
IMAGE_TAG=sha-<commit>

# Home Assistant LAN connection (required)
# Prefer fixed HAOS VM IP (for example: ws://192.168.1.50:8123/api/websocket)
HA_WS_URL=ws://homeassistant.local:8123/api/websocket
# Optional explicit HTTP base URL (if unset, derived from HA_WS_URL).
# Used by automation snapshot sync and analytics HA notification publishing.
HA_HTTP_URL=
HA_TOKEN=replace-with-home-assistant-long-lived-token

# Database
POSTGRES_DB=ha_ai
POSTGRES_USER=ha_ai
POSTGRES_PASSWORD=replace-with-strong-db-password

# Collector filters and tuning
EVENT_TYPES=state_changed,call_service
DOMAIN_ALLOWLIST=
DOMAIN_EXCLUDELIST=automation,updater
BATCH_SIZE=250
FLUSH_INTERVAL_SECONDS=2
RECONNECT_INITIAL_SECONDS=1
RECONNECT_MAX_SECONDS=30
RECONNECT_JITTER_RATIO=0.2
MAX_BUFFERED_EVENTS=5000
OVERFLOW_POLICY=drop_newest
RETRY_BACKPRESSURE_DELAY_MS=250
COLLECTOR_INSTANCE_ID=collector-proxmox
LOG_LEVEL=info

# Analytics / LLM (required for analytics scheduler)
OPENAI_API_KEY=replace-with-openai-api-key
ANALYTICS_TIMEZONE=UTC
REPORT_OUTPUT_DIR=/app/reports
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_ANALYSIS_MAX_INSIGHTS=5
LLM_ANALYSIS_WINDOW_HOURS=24
LLM_SCHEDULE_TIME=03:00
LLM_SCHEDULE_TIMEZONE=UTC
LLM_MAX_TOP_CHANGES=20
LLM_MAX_TRACE_CONTEXTS=10
LLM_MAX_EVENTS_PER_CONTEXT=60
LLM_TRACE_MAX_DEPTH=6
LLM_MAX_ENVIRONMENT_ITEMS_PER_TYPE=50
LLM_MAX_RESOURCE_USAGE_ITEMS_PER_TYPE=20
LLM_HA_NOTIFICATION_ENABLED=true
LLM_HA_NOTIFICATION_TITLE=Home Assistant AI Analysis
LLM_HA_NOTIFICATION_ID=ha_ai_llm_analysis_latest
LLM_HA_NOTIFICATION_MAX_CHARS=6000
LLM_HA_NOTIFICATION_REQUEST_TIMEOUT_MS=10000
LLM_REQUEST_TIMEOUT_MS=30000
LLM_RETRY_MAX_ATTEMPTS=3

# Daily home summary agent
DAILY_SUMMARY_SCHEDULE_TIME=00:10
DAILY_SUMMARY_SCHEDULE_TIMEZONE=UTC
DAILY_SUMMARY_TARGET_DAY_OFFSET=1
DAILY_SUMMARY_BASELINE_DAYS=7
DAILY_SUMMARY_MIN_BASELINE_DAYS=3
DAILY_SUMMARY_ANOMALY_ZSCORE_THRESHOLD=2
DAILY_SUMMARY_ANOMALY_MIN_DELTA=25
DAILY_SUMMARY_TOP_CHANGES_LIMIT=8
DAILY_SUMMARY_TOP_SUBJECTS_LIMIT=5
DAILY_SUMMARY_MAX_RESOURCE_USAGE_ITEMS_PER_TYPE=5
DAILY_SUMMARY_NOTIFICATION_ENABLED=true
DAILY_SUMMARY_NOTIFICATION_TITLE=Daily Home Summary
DAILY_SUMMARY_NOTIFICATION_ID=ha_ai_daily_summary_latest
DAILY_SUMMARY_NOTIFICATION_MAX_CHARS=6000
DAILY_SUMMARY_NOTIFICATION_REQUEST_TIMEOUT_MS=10000

# Retention scheduler
RETENTION_SCHEDULE_TIME=03:30
RETENTION_SCHEDULE_TIMEZONE=UTC
EVENTS_RETENTION_DAYS=14
EVENTS_PARTITION_LOOKBACK_DAYS=2
EVENTS_PARTITION_PRECREATE_DAYS=14
TRACE_CONTEXTS_RETENTION_DAYS=30
ENTITY_SNAPSHOTS_RETENTION_DAYS=30
AUTOMATION_SNAPSHOTS_RETENTION_DAYS=60
HA_ENVIRONMENT_SNAPSHOTS_RETENTION_DAYS=60
HA_USAGE_SNAPSHOTS_RETENTION_DAYS=180
AGENT_RUNS_RETENTION_DAYS=180
ORPHAN_ANALYSIS_RESULTS_RETENTION_DAYS=180
RETENTION_BATCH_SIZE=50000

# Automation snapshot scheduler
# Runs once immediately on service startup, then at schedule time daily.
AUTOMATION_SNAPSHOT_SCHEDULE_TIME=03:15
AUTOMATION_SNAPSHOT_SCHEDULE_TIMEZONE=UTC
AUTOMATION_SNAPSHOT_INCLUDE_CONFIG=true
AUTOMATION_SNAPSHOT_REQUEST_TIMEOUT_MS=10000
AUTOMATION_SNAPSHOT_WS_REQUEST_TIMEOUT_MS=10000
AUTOMATION_SNAPSHOT_CONFIG_FETCH_CONCURRENCY=5
AUTOMATION_SNAPSHOT_INCLUDE_ENVIRONMENT_INVENTORY=true
AUTOMATION_SNAPSHOT_INCLUDE_USAGE_SNAPSHOTS=true

# pgAdmin LAN exposure
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-strong-admin-password
PGADMIN_MASTER_PASSWORD_REQUIRED=false
PGADMIN_DB_HOST=postgres
PGADMIN_DB_PORT=5432
PGADMIN_DB_NAME=ha_ai
PGADMIN_DB_USER=ha_ai
PGADMIN_DB_PASSWORD=
PGADMIN_PORT_BIND=5050

# Optional GHCR credentials for deploy preflight login.
# If these are unset, deploy.sh expects prior `docker login ghcr.io`.
GHCR_USERNAME=
GHCR_TOKEN=

# Optional backup retention override (days)
BACKUP_RETENTION_DAYS=14
